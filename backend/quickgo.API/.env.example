# Copia este archivo como backend/quickgo.API/.env (queda fuera de git).
# Debe coincidir con infra/.env (el compose publica Postgres en el puerto 5433).
ConnectionStrings__PostgresConnection="Host=localhost;Port=5433;Database=quickgo;Username=quickgo;Password=quickgo_dev"

# Minimo 32 caracteres. Obligatoria fuera de Development. Genera una aleatoria propia.
Jwt__Key="cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres"
Jwt__ExpiraMinutos=60

# true = aplica las migraciones al iniciar la API
MigrarAlIniciar=true
